# MongoDB (run as a replica set so Prisma transactions work)
DATABASE_URL="mongodb://localhost:27017/ims?directConnection=true"

# Auth
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="8h"

# Base URL used to build password-reset links
APP_URL="http://localhost:3000"

# Sign the user out of the UI after this many minutes of inactivity
NEXT_PUBLIC_SESSION_TIMEOUT_MINUTES="30"

# SMTP for alert emails (optional - alerts still appear in-app without it)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="inventory@example.com"

# Comma-separated recipients for low-stock / expiry alert emails
ALERT_RECIPIENTS=""

NODE_ENV="development"
